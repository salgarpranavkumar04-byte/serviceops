NODE_ENV=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEY=change_this_to_a_random_32_char_string
ADMIN_READ_KEY=change_this_to_a_second_readonly_key
WEBHOOK_VERIFY_TOKEN=change_this_to_a_random_token
DATABASE_URL=postgresql://user:password@localhost:5432/serviceops
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_APP_SECRET=your_app_secret_for_hmac_verification
WHATSAPP_API_VERSION=v19.0
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_api_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CALLBACK_URL=https://your-domain.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
BASE_URL=http://localhost:8000
API_TIMEOUT_MS=5000
SHUTDOWN_DRAIN_TIMEOUT_MS=15000
MESSAGE_WORKER_CONCURRENCY=3
JOB_WORKER_CONCURRENCY=5
WHATSAPP_WORKER_CONCURRENCY=5
WHATSAPP_RATE_LIMIT_MAX=80
ENABLE_SIMULATE=false
# IMPORTANT: Never commit .env to version control. Rotate GOOGLE_MAPS_API_KEY immediately if it was previously committed.
